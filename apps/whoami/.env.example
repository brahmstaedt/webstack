# Copy to apps/whoami/.env and adjust.

# Main domain, same as in proxy/.env.
DOMAIN=example.com

# Exactly ONE address per service: its own host OR a sub-path on DOMAIN.
#   *_HOST  own hostname (DNS must point to this server)
#   *_PATH  sub-path on DOMAIN, for installations with only one domain
#
# Default: own hostnames.
PRIVATE_HOST=private.example.com
PRIVATE_PATH=
PUBLIC_HOST=public.example.com
PUBLIC_PATH=

# Single-domain installation instead:
#   PRIVATE_HOST=
#   PRIVATE_PATH=/private
#   PUBLIC_HOST=
#   PUBLIC_PATH=/public
#
# The example access rules in proxy/authelia/config/configuration.yml assume the path
# /private or the host private.<DOMAIN>. Adjust them if you choose other values.
